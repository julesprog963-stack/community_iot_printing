<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="community_iot_printing.ActionMenus" t-inherit="web.ActionMenus" t-inherit-mode="extension">
        <xpath expr="//Dropdown[1]" position="after">
            <Dropdown
                t-if="communityIotState.items.length"
                class="'d-inline-block'"
                togglerClass="'btn btn-outline-primary'"
            >
                <t t-set-slot="toggler">
                    <i class="fa fa-print me-1"/>
                    <span class="o_dropdown_title">IoT Print</span>
                </t>
                <t t-foreach="communityIotState.items" t-as="item" t-key="item.key">
                    <DropdownItem class="'o_menu_item'" onSelected="() => this.onCommunityIotItemSelected(item)">
                        <t t-esc="item.description"/>
                    </DropdownItem>
                </t>
            </Dropdown>
        </xpath>
    </t>
    <!-- CogMenu inherits ActionMenus methods but uses a separate template. -->
    <t t-name="community_iot_printing.CogMenu" t-inherit="web.CogMenu" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='printItems.length']" position="after">
            <Dropdown t-if="communityIotState.items.length">
                <t t-set-slot="toggler">
                    <i class="fa fa-print me-1"/> IoT Print
                </t>
                <DropdownItem
                    t-foreach="communityIotState.items"
                    t-as="item"
                    t-key="item.key"
                    class="'text-truncate o_menu_item o_community_iot_report'"
                    onSelected="() => this.onCommunityIotItemSelected(item)"
                >
                    <t t-esc="item.description"/>
                </DropdownItem>
            </Dropdown>
        </xpath>
    </t>
</templates>
